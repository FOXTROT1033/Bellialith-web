# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=https://bellialith.karmasect.xyz/auth/discord/callback

# Flask session signing key.
# Generate a long random value. Never commit your real value.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Production should be true when HTTPS is enabled.
COOKIE_SECURE=true

# Local development
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
